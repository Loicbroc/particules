{
  "name": "particules",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Application de reconstruction de photos par particules avec Three.js.",
  "scripts": {
    "test": "node --test",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler preview",
    "check:deploy": "npm run build && wrangler deploy --dry-run"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  }
}
